# FINCO Protocol — Environment Variables Example
# Copy this file to .env and fill in production values.
# DO NOT commit .env files with real secrets to version control.

# ─── Application Mode ───────────────────────────────────────────────────────────
# Allowed values: development, internal, pilot
# - development: allows placeholder/dev credentials with warnings
# - internal: same as development; single-user internal use
# - pilot: REQUIRES real secrets; fails fast on placeholder/insecure values
# FINCO_APP_MODE=development

# ─── Application ────────────────────────────────────────────────────────────────
# Secret signing key — REQUIRED in production/pilot mode.
# In development mode, a WARNING is printed if this is unset.
# FINCO_SECRET_KEY=changeme-dev-only-not-for-pilot

# Admin credentials — REQUIRED in production/pilot mode.
# FINCO_ADMIN_USER=admin
# FINCO_ADMIN_PASSWORD=changeme-dev-only-not-for-pilot
# FINCO_ADMIN_PASSWORD_HASH=  # Leave empty to use FINCO_ADMIN_PASSWORD; set bcrypt hash to override

# Session TTL in hours (default: 24)
# FINCO_SESSION_HOURS=24

# Cookie security — set to false only for local HTTP development.
# FINCO_COOKIE_SECURE=true

# Cookie SameSite policy (default: lax)
# FINCO_COOKIE_SAMESITE=lax

# CSRF secret — leave empty to use FINCO_SECRET_KEY
# FINCO_CSRF_SECRET=

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite database path (default: app/data/finco_runs.db)
# FINCO_DB_PATH=app/data/finco_runs.db

# ─── Backup ───────────────────────────────────────────────────────────────────────
# Backup directory (default: app/data/backups/sqlite)
# FINCO_BACKUP_DIR=app/data/backups/sqlite

# ─── Auto-Backup (Phase 24F.1) ─────────────────────────────────────────────────
# Automatic SQLite backup scheduling on top of Phase 24F manual backup/restore.
# Recommended: enabled for pilot mode, default for development/internal.
# Auto backups named: auto_finco_runs_*.db (separate from manual backups).
# FINCO_AUTO_BACKUP_ENABLED=true
# FINCO_AUTO_BACKUP_INTERVAL_HOURS=24   # Hours between auto backups
# FINCO_AUTO_BACKUP_MAX_FILES=10          # Max auto backups to retain (oldest pruned)

# ─── Development ───────────────────────────────────────────────────────────────
# WARNING: DEBUG mode is for local development only.
# Never enable DEBUG in production or publicly accessible deployments.
# DEBUG=false

# ─── Radar Live Data Sources ───────────────────────────────────────────────────
# Economy uses the FRED API. Without this key, Economy remains fail-closed and
# displays FRED_API_KEY_NOT_CONFIGURED rather than guessed macro values.
# Obtain a FRED API key from the official FRED developer portal.
# FRED_API_KEY=
#
# Crypto Overview and RWA use the CoinGecko Demo API. One backend key serves
# both surfaces. Without it, those domains remain fail-closed and display
# COINGECKO_DEMO_API_KEY_NOT_CONFIGURED. Never expose this key to browser JS.
# COINGECKO_DEMO_API_KEY=
#
# Stablecoins (DefiLlama) and Perpetuals (Hyperliquid public Info API) do not
# require these keys for their current read-only transports.

# ─── Feature Flags (INFORMATIONAL — both stay OFF by default) ──────────
# PR #886 documents these two flags for operators. PR #886 does
# NOT activate them and does NOT claim that the user-facing
# Inputs surface is fixed. The actual deployment decision is
# outside the scope of PR #886.
#
# FINCO_WORKBOOK_V2: Workbook V2 shell, sheets, and routes.
# Default: ACTIVE (absent or empty → on). Set to "0", "false", "no", or "off"
# to disable. Truthy values: 1, true, yes, on (case-insensitive,
# whitespace-stripped). Canonical parser: app.utils.workbook_flag.workbook_v2_active().
# The V2 routers are always mounted; the inactive guard (302 on GET, 409 on POSTs)
# fires only when this flag is explicitly set to a falsy value.
# FINCO_WORKBOOK_V2=0   # uncomment to disable V2
#
# FINCO_INPUTS_SLICE1_ENABLED: Canonical Inputs Slice 1 grid in the Inputs tab.
# Default: ACTIVE (absent or empty → on). Set to "0", "false", "no", or "off"
# to disable. Truthy values: 1, true, yes, on (case-insensitive,
# whitespace-stripped). Canonical parser: app.utils.workbook_flag.inputs_slice1_active().
# FINCO_INPUTS_SLICE1_ENABLED=0   # uncomment to disable Slice 1
