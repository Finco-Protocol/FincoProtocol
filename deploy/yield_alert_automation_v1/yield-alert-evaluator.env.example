# Copy to /etc/finco/yield-alert-evaluator.env as root, mode 0600.
# In-app alerts only: this evaluator sends NOTHING (no email, Telegram, Discord or
# push) and needs no secret. Never commit a populated copy.

# Disabled until an operator explicitly enables it on a reviewed host.
FINCO_YIELD_ALERT_AUTOMATION_ENABLED=0

# MUST be the same canonical history the web process and the Y-LIVE collector use,
# and the same application database the web process uses for the Yield Watchlist
# and alerts. A different path would silently evaluate nothing.
FINCO_YIELD_HISTORY_PATH=/var/lib/finco/yield/yield_history.jsonl
FINCO_DB_PATH=/var/lib/finco/finco.db

# Optional (default: <history path>.alerts-eval.lock)
# FINCO_YIELD_ALERT_LOCK_PATH=/var/lib/finco/yield/yield-alert-evaluator.lock
