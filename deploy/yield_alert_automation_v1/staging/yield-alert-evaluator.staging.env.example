# Copy to /opt/finco_staging/.env.yield-alert-evaluator (owner finco-staging, mode 0600).
# In-app alerts only. No secret is required. Never commit a populated copy.
FINCO_YIELD_ALERT_AUTOMATION_ENABLED=0
FINCO_YIELD_HISTORY_PATH=/opt/finco_staging/storage/yield/yield_history.jsonl
FINCO_DB_PATH=/opt/finco_staging/storage/finco_staging.db
