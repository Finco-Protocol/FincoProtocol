[Unit]
Description=FINCO Yield one-shot live observation collection (read-only)
Documentation=https://github.com/Finco-Protocol/FincoProtocol/blob/main/deploy/yield_collector_v1/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=finco
Group=finco
WorkingDirectory=/opt/finco_protocol
EnvironmentFile=/etc/finco/yield-collector.env
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=finco/yield
StateDirectoryMode=0750
UMask=0027
ExecStart=/usr/bin/flock -n -E 75 /var/lib/finco/yield/yield-collector.lock /opt/finco_protocol/.venv/bin/python -m finco_yield.collect_live
TimeoutStartSec=240
# Exit 3 = PARTIAL (valid observations persisted, some targets failed): visible
# in the report/journal but not a failed unit. Exit 2/4/75 stay failures.
SuccessExitStatus=3
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=finco-yield-collector
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/finco/yield
ProtectHome=true
PrivateTmp=true

# Deliberately no [Install]: only the timer (or a manual start) activates this unit.
