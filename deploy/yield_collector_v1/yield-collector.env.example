# Copy to /etc/finco/yield-collector.env as root, mode 0600.
# The collector is READ-ONLY: no wallet, signing, custody or transaction, and it
# needs no API key or secret. Never commit a populated copy.

# Disabled until an operator explicitly enables collection on a reviewed host.
FINCO_YIELD_COLLECTOR_ENABLED=0

# The web service MUST read the SAME two paths (see README). A collector writing
# somewhere the web process does not read would silently serve reference data.
FINCO_YIELD_SNAPSHOT_PATH=/var/lib/finco/yield/current_snapshot.json
FINCO_YIELD_HISTORY_PATH=/var/lib/finco/yield/yield_history.jsonl

# Optional tuning (defaults shown). Interval is clamped to <= 1500 s so the
# newest history row never ages past the 1800 s NATIVE_ENRICHED freshness window.
# FINCO_YIELD_SOURCE_TIMEOUT_SECONDS=8
# FINCO_YIELD_HISTORY_MIN_INTERVAL_SECONDS=900
# FINCO_YIELD_MORPHO_API_URL=https://api.morpho.org/graphql
