# Copy to /opt/finco_staging/.env.yield-collector (owner finco-staging, mode 0600).
# Read-only collector. No secret is required. Never commit a populated copy.
FINCO_YIELD_COLLECTOR_ENABLED=0
FINCO_YIELD_SNAPSHOT_PATH=/opt/finco_staging/storage/yield/current_snapshot.json
FINCO_YIELD_HISTORY_PATH=/opt/finco_staging/storage/yield/yield_history.jsonl
