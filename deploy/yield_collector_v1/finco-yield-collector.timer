[Unit]
Description=Collect FINCO Yield live observations every ten minutes
Documentation=https://github.com/Finco-Protocol/FincoProtocol/blob/main/deploy/yield_collector_v1/README.md

[Timer]
Unit=finco-yield-collector.service
OnCalendar=*-*-* *:00/10:00
AccuracySec=5s
RandomizedDelaySec=0
Persistent=true

[Install]
WantedBy=timers.target
