# FINCO Model Production Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Security ──────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
FINCO_SECRET_KEY=changeme_generate_a_real_secret_key_here

# ── Admin User ─────────────────────────────────────────────────────────────
# Create your admin account credentials here.
FINCO_ADMIN_USER=admin
FINCO_ADMIN_PASSWORD=changeme_set_a_strong_password_here

# ── Session ─────────────────────────────────────────────────────────────────
# How long sessions last (in hours)
FINCO_SESSION_HOURS=8

# ── Cookie Security ─────────────────────────────────────────────────────────
# Set to 'true' in production (requires HTTPS)
FINCO_COOKIE_SECURE=true

# ── Database ───────────────────────────────────────────────────────────────
# Path to SQLite database file (absolute path recommended)
FINCO_DB_PATH=/opt/finco_protocol/storage/finco.db

# ── Radar live market / macro sources ──────────────────────────────────────
# Economy: required for live FRED observations. Missing key is intentionally
# fail-closed and renders FRED_API_KEY_NOT_CONFIGURED.
FRED_API_KEY=replace_with_real_fred_api_key

# Crypto Overview + RWA: one backend-only CoinGecko Demo API key serves both.
# Missing key is intentionally fail-closed and renders
# COINGECKO_DEMO_API_KEY_NOT_CONFIGURED.
COINGECKO_DEMO_API_KEY=replace_with_real_coingecko_demo_api_key

# Current Stablecoins (DefiLlama) and Perpetuals (Hyperliquid Info API) reads
# are public and do not require additional runtime keys.
