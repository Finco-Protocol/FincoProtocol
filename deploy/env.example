# FINCO Model Production Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application mode (P0-C) ────────────────────────────────────────────────
# Production and staging MUST run the secure mode. deploy/systemd/finco-web.service sets it and
# deploy/scripts/run_web.sh refuses to start otherwise. Never set development/internal here.
FINCO_APP_MODE=pilot

# ── Security ──────────────────────────────────────────────────────────────
# File permissions: this file must be owned by the service user with mode 0600
#   (chown finco:finco /opt/finco_protocol/.env && chmod 600 /opt/finco_protocol/.env).
# Never pass secrets on a command line (visible in the process list); use this file only.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
FINCO_SECRET_KEY=changeme_generate_a_real_secret_key_here

# ── Admin User ─────────────────────────────────────────────────────────────
# Secure mode REFUSES: a missing password, the repository default, any placeholder, or fewer
# than 12 characters. Prefer a bcrypt hash: set FINCO_ADMIN_PASSWORD_HASH instead of the plain value.
FINCO_ADMIN_USER=admin
FINCO_ADMIN_PASSWORD=changeme_set_a_strong_password_here

# ── Session ─────────────────────────────────────────────────────────────────
# How long sessions last (in hours)
FINCO_SESSION_HOURS=8

# ── Cookie Security ─────────────────────────────────────────────────────────
# Set to 'true' in production (requires HTTPS)
FINCO_COOKIE_SECURE=true

# ── Web service ─────────────────────────────────────────────────────────────
# Canonical production launcher: deploy/scripts/run_web.sh
# Loopback bind is intended for the Nginx reverse proxy on the same host.
FINCO_WEB_HOST=127.0.0.1
FINCO_WEB_PORT=8000
FINCO_WEB_WORKERS=2
FINCO_WEB_GRACEFUL_SHUTDOWN_SECONDS=30

# ── Database ───────────────────────────────────────────────────────────────
# Path to SQLite database file (absolute path recommended)
FINCO_DB_PATH=/opt/finco_protocol/storage/finco.db

# ── Radar live market / macro sources ──────────────────────────────────────
# Economy: required for live FRED observations. Missing key is intentionally
# fail-closed and renders FRED_API_KEY_NOT_CONFIGURED.
FRED_API_KEY=replace_with_real_fred_api_key

# Crypto Overview + RWA: one backend-only CoinGecko Demo API key serves both.
# Missing key is intentionally fail-closed and renders
# COINGECKO_DEMO_API_KEY_NOT_CONFIGURED.
COINGECKO_DEMO_API_KEY=replace_with_real_coingecko_demo_api_key

# R-LIVE V2 current reads need a Robinhood Chain 4663 HTTPS RPC in the WEB
# process. Server-side private configuration only; missing fails closed.
# Never print or expose the populated value in browser output or logs.
ROBINHOOD_RPC_URL=

# Durable R-LIVE/B1.3 ledger: web reader and collector MUST share this path.
# Preserve any existing canonical history; do not replace it with an empty DB.
RADAR_BNB_INTELLIGENCE_DB_PATH=/var/lib/finco/radar/radar_bnb_intelligence.db

# Current Stablecoins (DefiLlama) and Perpetuals (Hyperliquid Info API) reads
# are public and do not require additional runtime keys.

# ── $FINCO token gate (ACTIVATION READINESS — all commented; gating is OFF
#    by default and must stay OFF until docs/TOKEN_GATE_ACTIVATION_RUNBOOK.md
#    steps 1–6 are completed by a reviewed change) ─────────────────────────
# FINCO_TOKEN_CHAIN_ID=            # exact chain id of the approved deployment
# FINCO_TOKEN_ADDRESS=             # exact deployed ERC-20 contract (0x + 40 hex)
# FINCO_TOKEN_DECIMALS=            # explicit decimals authority (required for
#                                  # deterministic balance conversion)
# FINCO_ACCESS_MIN_BALANCE=        # threshold in token units (product decision)
# FINCO_TOKEN_RPC_URL=<chain>=     # chain-scoped read-only RPC provider the
#                                  # evaluator consumes (server-side only)
# FINCO_ENTITLEMENT_POLICIES_JSON= # per-resource policy overrides (enabled /
#                                  # minimum_balance / chain_id)
# FINCO_TOKEN_GATING_ENABLED=1     # LAST step only — activates token gating
