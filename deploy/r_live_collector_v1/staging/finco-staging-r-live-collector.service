[Unit]
Description=FINCO staging R-LIVE one-shot all-approved-asset collection
Documentation=https://github.com/Finco-Protocol/FincoProtocol/blob/main/deploy/r_live_collector_v1/staging/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=finco
Group=finco
WorkingDirectory=/opt/finco_staging
EnvironmentFile=/opt/finco_staging/.env.r-live-collector
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
ExecStart=/usr/bin/flock -n -E 75 /opt/finco_staging/storage/r-live-collector.lock /opt/finco_staging/.venv/bin/python -m app.radar_rwa.r_live_collect
TimeoutStartSec=540
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=finco-staging-r-live-collector
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/finco_staging/storage
ProtectHome=true
PrivateTmp=true

# Deliberately no [Install]: only the staging timer or a manual start runs it.
