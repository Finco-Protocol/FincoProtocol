# Copy privately to /opt/finco_staging/.env.r-live-collector (root:root, 0600).
# Do not commit a populated file, print its values, or put credentials in unit files.
FINCO_ENV=staging

# Approved Robinhood Chain 4663 HTTPS RPC; same source as staging web.
ROBINHOOD_RPC_URL=

# Exact same existing B1.3 ledger as /opt/finco_staging/.env.staging uses.
# Inspect and back up existing canonical history before enabling collection.
RADAR_BNB_INTELLIGENCE_DB_PATH=/opt/finco_staging/storage/radar_bnb_intelligence.db
