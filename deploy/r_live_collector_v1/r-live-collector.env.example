# Copy to /etc/finco/r-live-collector.env as root with mode 0600.
# Insert the approved Robinhood Chain 4663 HTTPS RPC endpoint in the private copy.
# Never commit the populated file or print its value in diagnostics.
ROBINHOOD_RPC_URL=

# Collector and web/history readers MUST use this same existing B1.3 SQLite ledger.
# Verify or migrate the previous ledger before enabling the timer; never start a
# second empty ledger while canonical history exists elsewhere.
RADAR_BNB_INTELLIGENCE_DB_PATH=/var/lib/finco/radar/radar_bnb_intelligence.db
