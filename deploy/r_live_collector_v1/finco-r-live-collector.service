[Unit]
Description=FINCO R-LIVE one-shot AAPL premium collection
Documentation=https://github.com/Finco-Protocol/FincoProtocol/blob/main/deploy/r_live_collector_v1/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=finco
Group=finco
WorkingDirectory=/opt/finco_protocol
EnvironmentFile=/etc/finco/r-live-collector.env
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=finco/radar
StateDirectoryMode=0750
UMask=0077
ExecStart=/usr/bin/flock -n -E 75 /var/lib/finco/radar/r-live-collector.lock /opt/finco_protocol/.venv/bin/python -m app.radar_rwa.r_live_collect
TimeoutStartSec=240
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=finco-r-live-collector
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

# Deliberately no [Install]: only the timer (or a manual start) activates this unit.
