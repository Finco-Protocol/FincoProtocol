# Copy to /etc/finco/tokenized-market-collector.env as root, mode 0600.
# Read-only market collector. No wallet/signing/custody/trading path exists.
# Never commit a populated copy.

# Explicit operator activation only.
FINCO_TOKENIZED_COLLECTOR_ENABLED=0

# Reviewed Robinhood Chain 4663 HTTPS RPC endpoint. Keep private.
ROBINHOOD_RPC_URL=

# MUST be the same canonical venue database read by the web runtime.
FINCO_VENUE_DB_PATH=/var/lib/finco/radar/venues_market_observations.db

# Bounded runtime defaults.
FINCO_TOKENIZED_COLLECTOR_MAX_ASSETS=32
FINCO_TOKENIZED_COLLECTOR_WORKERS=2
FINCO_TOKENIZED_COLLECTOR_RETRIES=1
FINCO_TOKENIZED_COLLECTOR_BACKOFF_SECONDS=0.25

# Read-only intelligence policy defaults.
FINCO_TOKENIZED_MARKET_MAX_AGE_SECONDS=900
FINCO_TOKENIZED_DISLOCATION_THRESHOLD_BPS=100
