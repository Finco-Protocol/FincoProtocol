# Copy privately to /opt/finco_staging/.env.tokenized-market-collector (0600).
FINCO_ENV=staging
FINCO_TOKENIZED_COLLECTOR_ENABLED=0

ROBINHOOD_RPC_URL=
FINCO_VENUE_DB_PATH=/opt/finco_staging/storage/radar/venues_market_observations.db

FINCO_TOKENIZED_COLLECTOR_MAX_ASSETS=32
FINCO_TOKENIZED_COLLECTOR_WORKERS=2
FINCO_TOKENIZED_COLLECTOR_RETRIES=1
FINCO_TOKENIZED_COLLECTOR_BACKOFF_SECONDS=0.25
FINCO_TOKENIZED_MARKET_MAX_AGE_SECONDS=900
FINCO_TOKENIZED_DISLOCATION_THRESHOLD_BPS=100
