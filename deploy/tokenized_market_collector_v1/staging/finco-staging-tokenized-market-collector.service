[Unit]
Description=FINCO staging Tokenized Markets one-shot live evidence collection
Documentation=https://github.com/Finco-Protocol/FincoProtocol/blob/main/deploy/tokenized_market_collector_v1/staging/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=finco
Group=finco
WorkingDirectory=/opt/finco_staging
EnvironmentFile=/opt/finco_staging/.env.tokenized-market-collector
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
ExecStart=/usr/bin/flock -n -E 75 /opt/finco_staging/storage/tokenized-market-collector.lock /opt/finco_staging/.venv/bin/python -m app.radar_rwa.tokenized_collect
TimeoutStartSec=540
SuccessExitStatus=3
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=finco-staging-tokenized-market-collector
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/finco_staging/storage
ProtectHome=true
PrivateTmp=true

# Deliberately no [Install]: only the staging timer or a manual start runs it.
