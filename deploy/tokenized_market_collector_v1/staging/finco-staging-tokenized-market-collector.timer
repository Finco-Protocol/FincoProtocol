[Unit]
Description=Collect FINCO staging Tokenized Markets live evidence every five minutes
Documentation=https://github.com/Finco-Protocol/FincoProtocol/blob/main/deploy/tokenized_market_collector_v1/staging/README.md

[Timer]
Unit=finco-staging-tokenized-market-collector.service
OnCalendar=*-*-* *:00/5:00
AccuracySec=5s
RandomizedDelaySec=0
Persistent=true

[Install]
WantedBy=timers.target
