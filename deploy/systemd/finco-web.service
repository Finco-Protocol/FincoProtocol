[Unit]
Description=FINCO Model Web Application
After=network.target

[Service]
Type=simple
User=finco
Group=finco
WorkingDirectory=/opt/finco_protocol

# The service manager owns production environment loading. run_web.sh validates
# mandatory configuration without printing values.
EnvironmentFile=/opt/finco_protocol/.env
Environment="PATH=/opt/finco_protocol/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Canonical repository-provided ASGI command. CI starts this same launcher.
ExecStart=/bin/bash /opt/finco_protocol/deploy/scripts/run_web.sh

# Restart / shutdown policy
Restart=on-failure
RestartSec=5
TimeoutStopSec=45

# Security: no new privileges
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
