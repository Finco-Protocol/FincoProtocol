# FINCO Protocol — Staging / Public Demo Environment Variables
# Copy to .env.staging and fill in real values.
# NEVER commit .env.staging to version control.
# This file is separate from deploy/env.example (production).
# The staging DB and storage directories are DIFFERENT from production paths.

# ── Environment identity ───────────────────────────────────────────────────
# Must be one of: staging, demo, test, development
# Never set to "production" on a staging instance.
FINCO_ENV=staging

# Application mode: "pilot" enables pilot-mode guards and demo rate limiting.
FINCO_APP_MODE=pilot

# ── Security ───────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
# Use a DIFFERENT secret from production — staging sessions must not be
# accepted by the production application.
FINCO_SECRET_KEY=changeme_generate_a_separate_staging_secret_key_here

# ── Admin credentials ──────────────────────────────────────────────────────
FINCO_ADMIN_USER=staging_admin
FINCO_ADMIN_PASSWORD=changeme_set_a_strong_staging_password_here

# ── Session TTL ─────────────────────────────────────────────────────────────
FINCO_SESSION_HOURS=4

# ── Demo session settings ───────────────────────────────────────────────────
# TTL for demo sessions (hours). Data older than this is eligible for cleanup.
FINCO_DEMO_TTL_HOURS=24

# ── Cookie security ─────────────────────────────────────────────────────────
# Set to 'true' when staging is served over HTTPS (recommended).
FINCO_COOKIE_SECURE=true

# ── Database ────────────────────────────────────────────────────────────────
# STAGING DB PATH — must be separate from the production database.
# Never point staging at the production DB file.
FINCO_DB_PATH=/opt/finco_staging/storage/finco_staging.db

# ── Storage / exports ───────────────────────────────────────────────────────
# Reserved variable for a future export-storage directory feature.
# Not consumed by any current code path — setting it has no effect today.
# Defined here so operators can set it in anticipation of the feature.
FINCO_STORAGE_PATH=/opt/finco_staging/exports

# ── Concurrency ─────────────────────────────────────────────────────────────
# Per-process concurrent model run limit.
# Effective total = FINCO_MAX_CONCURRENT_RUNS × Gunicorn workers.
# Staging recommendation: 3 runs × 2 workers = 6 effective concurrent runs.
FINCO_MAX_CONCURRENT_RUNS=3

# ── Demo reset opt-in ───────────────────────────────────────────────────────
# Required second factor for tools/demo_reset.py. Must be set to exactly
# 'true' (case-sensitive). Prevents accidental invocations.
# Only set this on staging instances where intentional demo reset is needed.
FINCO_DEMO_RESET_ALLOWED=true

# ── Gunicorn workers ────────────────────────────────────────────────────────
# Set in the Gunicorn command: --workers 2
# With uvicorn single-worker, set FINCO_MAX_CONCURRENT_RUNS=8 instead.
# GUNICORN_WORKERS=2   # set on the command line, not here

# ── Radar Equity Fundamentals (E1/E2/E3) ─────────────────────────────────────
# Equity fundamentals DB for the Radar Company Terminal (E1/E2/E3 features).
# This is SEPARATE from FINCO_DB_PATH — the equity time-series DB is NOT the
# main application DB.  Do not point them at the same file.
#
# Path rules:
#   • Must be an absolute path under /opt/finco_staging.
#   • Must NOT reference the production deployment root (/opt/finco_protocol/).
#   • Use a VERSIONED filename for each new deployment snapshot, e.g.:
#       equity_fundamentals_20260922T191856Z.db
#
# Mode 'snapshot': WAL-checkpointed standalone immutable SQLite snapshot.
#   Opens with mode=ro&immutable=1 — safe for a standalone read-only file
#   that will not change while the service runs.  Required for E5 staging.
#   Do NOT point snapshot mode at a mutating WAL database.
#
# Mode 'live': read-only open on a live WAL database being written by an
#   ingestion process.  Only valid when a staging ingestion process actively
#   writes to this DB.  Requires directory write access for WAL/SHM files.
#   Not used for E5 staging unless a live ingestion contract is in place.
FINCO_EQUITY_FUNDAMENTALS_DB_PATH=/opt/finco_staging/storage/equity_fundamentals.db
FINCO_EQUITY_FUNDAMENTALS_DB_MODE=snapshot

# ── TLS / HTTPS ─────────────────────────────────────────────────────────────
# Terminate TLS at Nginx (recommended). Gunicorn listens on loopback only.
# Example Nginx config: deploy/nginx/
# Do NOT point staging to production TLS certificates or production domain.
