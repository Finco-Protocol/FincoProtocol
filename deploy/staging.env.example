# FINCO Protocol — Corporate Staging Environment Variables
# Copy OUTSIDE the repository to /opt/finco_staging/.env.staging and fill in
# real values. Then chmod 600 /opt/finco_staging/.env.staging.
# NEVER commit the real .env.staging file.
# Production uses a different root, environment file, DB, secrets and port.

# ── Deployment identity ────────────────────────────────────────────────────
FINCO_ENV=staging
FINCO_APP_MODE=pilot
FINCO_STAGING_ROOT=/opt/finco_staging
FINCO_STAGING_PORT=8100
FINCO_STAGING_HOST=staging.finco.one

# Exact 40-character commit SHA checked out on the staging host.
# tools/staging_preflight.py refuses startup if git HEAD differs.
FINCO_DEPLOY_SHA=replace_with_exact_40_character_commit_sha

# ── Security ───────────────────────────────────────────────────────────────
# Generate a UNIQUE staging secret, different from production:
# python3 -c "import secrets; print(secrets.token_hex(64))"
FINCO_SECRET_KEY=changeme_generate_a_separate_staging_secret_key_here

# Staging-only admin credentials. Never reuse production credentials.
FINCO_ADMIN_USER=staging_admin
FINCO_ADMIN_PASSWORD=changeme_set_a_unique_staging_password_16_chars_or_more

# ── Session / demo policy ──────────────────────────────────────────────────
FINCO_SESSION_HOURS=4
FINCO_DEMO_TTL_HOURS=24
FINCO_COOKIE_SECURE=true

# ── Database isolation ─────────────────────────────────────────────────────
# Must remain under /opt/finco_staging and must never point at production.
FINCO_DB_PATH=/opt/finco_staging/storage/finco_staging.db

# ── Storage / exports isolation ────────────────────────────────────────────
# Reserved by the current application for future explicit export-storage
# wiring. P7 still requires a staging-only path so the operational contract is
# ready before that feature is activated.
FINCO_STORAGE_PATH=/opt/finco_staging/storage/exports

# ── Concurrency ────────────────────────────────────────────────────────────
# Per-process limit. The staging systemd unit uses two uvicorn workers.
# 3 × 2 workers = effective maximum of 6 concurrent model-run slots.
FINCO_MAX_CONCURRENT_RUNS=3

# ── Demo reset opt-in ──────────────────────────────────────────────────────
# Required second factor for tools/demo_reset.py. Never enable on production.
FINCO_DEMO_RESET_ALLOWED=true

# ── TLS / HTTPS ────────────────────────────────────────────────────────────
# TLS terminates at the staging Nginx vhost. The application binds loopback
# only on port 8100. Do not reuse the app.finco.one production certificate.
