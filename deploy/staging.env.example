# FINCO Protocol — Yield Phase 1 Staging Environment
# Copy OUTSIDE the repository to /opt/finco_staging/.env.staging and fill real values.
# chmod 600 /opt/finco_staging/.env.staging
# NEVER commit the populated file. Staging secrets/data must be distinct from production.

# ── Deployment identity ────────────────────────────────────────────────────
FINCO_ENV=staging
FINCO_APP_MODE=pilot
FINCO_STAGING_ROOT=/opt/finco_staging
FINCO_STAGING_PORT=8100
FINCO_STAGING_HOST=staging.finco.one

# Exact 40-character commit SHA checked out on the staging host.
# tools/staging_preflight.py fails closed if git HEAD differs.
FINCO_DEPLOY_SHA=replace_with_exact_40_character_commit_sha

# ── Security ───────────────────────────────────────────────────────────────
# Generate independent staging-only values, for example with secrets.token_hex(64).
FINCO_SECRET_KEY=changeme_generate_a_separate_staging_secret_key_here
FINCO_CSRF_SECRET=changeme_generate_a_separate_staging_csrf_secret_here

# Use EITHER FINCO_ADMIN_PASSWORD OR FINCO_ADMIN_PASSWORD_HASH, not both.
# Secure pilot mode rejects repository defaults, placeholders and weak credentials.
FINCO_ADMIN_USER=staging_admin
FINCO_ADMIN_PASSWORD=changeme_set_a_unique_staging_password_16_chars_or_more
# FINCO_ADMIN_PASSWORD_HASH=$2b$12$replace_with_real_staging_bcrypt_hash

FINCO_SESSION_HOURS=4
FINCO_DEMO_TTL_HOURS=24
FINCO_COOKIE_SECURE=true
FINCO_COOKIE_SAMESITE=lax

# Demo reset is not needed for Yield Phase 1 acceptance.
FINCO_DEMO_RESET_ALLOWED=false

# ── Web service ────────────────────────────────────────────────────────────
# Staging uses the canonical PR #152 secure ASGI launcher with an isolated loopback port.
FINCO_WEB_HOST=127.0.0.1
FINCO_WEB_PORT=8100
FINCO_WEB_WORKERS=2
FINCO_WEB_GRACEFUL_SHUTDOWN_SECONDS=30

# ── Runtime execution gate (PR #152) ──────────────────────────────────────
# PROCESS_LOCAL: effective host ceiling = workers × concurrency.
FINCO_MODEL_EXECUTION_CONCURRENCY=2
FINCO_MODEL_EXECUTION_MODE=process
FINCO_MODEL_EXECUTION_TIMEOUT_SECONDS=180

# ── Yield Phase 1 ──────────────────────────────────────────────────────────
# Browser/read-only acceptance only. Execution MUST stay disabled.
FINCO_YIELD_ENABLED=1
FINCO_YIELD_EXECUTION_ENABLED=0
# Optional append-only observation history path. Leave empty unless a reviewed
# staging history writer/source exists; the product then reports HISTORY_NOT_CONFIGURED.
FINCO_YIELD_HISTORY_PATH=

# ── Database / storage isolation ───────────────────────────────────────────
FINCO_DB_PATH=/opt/finco_staging/storage/finco_staging.db
FINCO_STORAGE_PATH=/opt/finco_staging/exports

# ── Radar live market / macro sources ─────────────────────────────────────
# Populate real staging-only backend keys in the private env file. Missing providers
# remain fail-closed and must never be replaced with fabricated values.
FRED_API_KEY=replace_with_real_staging_fred_api_key
COINGECKO_DEMO_API_KEY=replace_with_real_staging_coingecko_demo_api_key

# Server-side Robinhood Chain 4663 RPC. Never expose this value in browser output/logs.
ROBINHOOD_RPC_URL=

# Durable staging-only R-LIVE/B1.3 history ledger. Never point at production.
RADAR_BNB_INTELLIGENCE_DB_PATH=/opt/finco_staging/storage/radar_bnb_intelligence.db

# ── Radar Equity Fundamentals ──────────────────────────────────────────────
FINCO_EQUITY_FUNDAMENTALS_DB_PATH=/opt/finco_staging/storage/equity_fundamentals.db
FINCO_EQUITY_FUNDAMENTALS_DB_MODE=snapshot

# ── TLS / HTTPS ────────────────────────────────────────────────────────────
# TLS terminates at Nginx for staging.finco.one. The app itself stays on loopback:8100.
